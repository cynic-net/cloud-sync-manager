from    csm.config  import *
from    pytest  import mark, raises

####################################################################
#   SyncPath

@mark.parametrize('pathstr', [
    '/this/path/does/not/exist/i/hope',
    'foo/bar',
    '~/stuff',
])
def test_SyncPath_path_and_an_attr(pathstr):
    sp = SyncPath(pathstr, { 'foo': 'bar'})
    assert sp.path.is_absolute()
    assert str(sp.path).endswith(pathstr.removeprefix('~'))
    assert sp['foo'] == 'bar'

def test_SyncPath_no_remote():
    ' SyncPath with no `remote` key is invalid. '
    sp = SyncPath('/foo', {})
    assert not sp.valid(set())

def test_SyncPath_invalid_remote():
    ' SyncPath with `remote` key not in known remotes is invalid. '
    sp = SyncPath('/foo', {'remote': 'myremote:sub/dir'})
    assert not sp.valid({'other', 'another'})

def test_SyncPath_valid():
    ' SyncPath with `remote` key matching a known remote is valid. '
    sp = SyncPath('/foo', {'remote': 'myremote:sub/dir'})
    assert sp.valid({'myremote', 'other'})

def test_parse_toml_drops_no_remote(capsys):
    ' Entries with no remote are dropped with warning. '
    toml = '''
        ['/valid']
        remote = 'r:'
        ['/no-remote']
        description = 'missing remote key'
    '''
    c = Config(toml, {'r'})
    assert 1 == len(c)
    assert '/valid' in c
    assert '/no-remote' not in c
    err = capsys.readouterr().err
    assert 'ignoring /no-remote' in err
    assert 'no remote specified' in err

def test_parse_toml_drops_unknown_remote(capsys):
    ' Entries with unknown remote are dropped with warning. '
    toml = '''
        ['/valid']
        remote = 'known:'
        ['/unknown']
        remote = 'notknown:path'
    '''
    c = Config(toml, {'known'})
    assert 1 == len(c)
    assert '/valid' in c
    assert '/unknown' not in c
    err = capsys.readouterr().err
    assert 'ignoring /unknown' in err
    assert "rclone has no remote 'notknown'" in err

####################################################################
#   Config

config_toml = '''
    ['~/cloud/foo']
    descripton = 'The foo files.'
    remote = 'my-foo:'              # rclone remote `my-foo:`
    action = 'bisync'               # see actions below
    period = '5m'                   # optional; see "Periodic Actions" below

    [a]
    remote = 'r-a:'

    [b]
    remote = 'r-b:'
'''
config_toml_remotes = {'my-foo', 'r-a', 'r-b', 'r-z'}

def test_readconfig():
    c = Config()
    assert 0 == len(c)

    c.parse_toml(config_toml, config_toml_remotes)
    assert 3 == len(c)

    assert c[Path('~/cloud/foo').expanduser().resolve()]
    assert c[Path('~/cloud/foo')]
    assert c['~/cloud/foo']
    assert c.get('~/cloud/foo')

    add_toml = '''
        [z]
        remote = 'r-z:'
        description = 'Additional TOML.'
    '''
    c.parse_toml(add_toml, config_toml_remotes)
    assert 4 == len(c)
    assert c['z']['description'] == 'Additional TOML.'

groups_toml = '''
    ['/p1']
    remote = 'r:'
    ['/p2']
    remote = 'r:'
    groups = ['g2+']
    ['/p3']
    remote = 'r:'
    groups = ['g2+', 'g3+']
    ['/p4']
    remote = 'r:'
    groups = ['g2+', 'g3+', 'g4+']
'''
groups_toml_remotes = {'r'}

def test_groups_toml_groups():
    c = Config(groups_toml, groups_toml_remotes)
    def grouplist(name):
        return [ sp.prettypath for sp in c.group(name) ]
    assert                    [] == grouplist('nonexistent')
    assert               ['/p4'] == grouplist('g4+')
    assert        ['/p3', '/p4'] == grouplist('g3+')
    assert ['/p2', '/p3', '/p4'] == grouplist('g2+')

@mark.parametrize('path_groups, paths', [
    (('/p1',                ),  ('/p1',                             )),
    (('/p4', '/p2',         ),  ('/p4', '/p2',                      )),
    (('/p3', 'g4+', '/p1'   ),  ('/p3', '/p4', '/p1',               )),
    (('g2+',                ),  ('/p2', '/p3', '/p4',               )),
    #   Dups removed; order maintained.
    #   XXX do we really want to bother?
   #(('/p4', 'g3+',         ),  ('/p4', '/p3',                      )),
])
def test_expand_groups_ok(path_groups, paths):
    c = Config(groups_toml, groups_toml_remotes)
    sps = c.expand_groups(path_groups)
    assert list(paths) == [ sp.prettypath for sp in sps ]

def test_expand_groups_errs():
    c = Config(groups_toml, groups_toml_remotes)
    with raises(KeyError) as ex:
        c.expand_groups(['/not/here', 'notagroup', '/not/there'])
    assert ex.match('Cannot match groups/paths:' \
        r" \['/not/here', 'notagroup', '/not/there'\]")
